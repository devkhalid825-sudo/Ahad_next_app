# Elipse Studio - Apache Configuration
# This file ensures SPAs work correctly, dynamic sitemap is proxied or served, and static files like robots.txt are served properly

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # WWW → non-WWW canonical redirect
  RewriteCond %{HTTP_HOST} ^www\.elipsestudio\.com [NC]
  RewriteRule ^(.*)$ https://elipsestudio.com/$1 [R=301,L]

  # Redirect /sitemap or /sitemap/ directly to /sitemap.xml
  RewriteRule ^sitemap/?$ https://elipsestudio.com/sitemap.xml [R=301,L]

  # 1a. Sitemap XML files — serve statically from build output (generated by prebuild script)
  # Static files are always fresher than redirecting to the backend host
  RewriteCond %{REQUEST_URI} ^/(sitemap|pages_sitemap|projects_sitemap|blogs_sitemap|casestudies_sitemap)\.xml$ [NC]
  RewriteRule ^ - [L]

  # 1b. Force robots.txt to be served as static file
  RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC]
  RewriteRule ^ - [L]

  # 1c. Redirect search engine bots & social media crawlers to backend for prerendered HTML
  # Googlebot, Bingbot, etc. get full prerendered pages (via Puppeteer).
  # Social media bots get lightweight meta-tag pages.
  # NOTE: Both redirect via 301 and the backend returns proper HTML with canonical tags.
  RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|yandexbot|duckduckbot|baiduspider|facebookexternalhit|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot|discordbot|applebot|ia_archiver|embedly|quora\ link\ preview|outbrain|pinterest|semrush|ahrefsbot|mj12bot|screaming\ frog) [NC]
  RewriteCond %{REQUEST_URI} !^/(assets|uploads|sitemap|pages_sitemap|projects_sitemap|blogs_sitemap|casestudies_sitemap)\.?(xml|js|css|png|jpg|jpeg|gif|webp|ico|svg|woff|woff2|ttf)? [NC]
  RewriteCond %{REQUEST_URI} !^/admin
  RewriteRule ^(.*)$ https://mediumseagreen-crocodile-699024.hostingersite.com/$1 [R=301,L]

  # 1d. 410 Gone for junk/spam URL families — terminal status so Google drops them
  # WordPress probe & dummy PHP files
  RewriteRule wp- - [G]
  RewriteRule ^xmlrpc\.php - [G]

  # Spam directories (e.g. /products/14352842/, /ctg/search/..., /tpc/...)
  RewriteRule ^products(/|$) - [G]
  RewriteRule ^ctg(/|$) - [G]
  RewriteRule ^tpc(/|$) - [G]
  RewriteRule ^feed/?$ - [G]
  RewriteRule ^trackback/?$ - [G]
  RewriteRule ^comments/feed/?$ - [G]
  RewriteRule ^author/ - [G]
  RewriteRule ^page/ - [G]

  # Spam query strings (ctgItemCd, similarImageSearch, mycatalog, etc.)
  RewriteCond %{QUERY_STRING} ctgItemCd [NC,OR]
  RewriteCond %{QUERY_STRING} similarImageSearch [NC,OR]
  RewriteCond %{QUERY_STRING} mycatalog [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)p= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)s= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)page_id= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)cat= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)author= [NC]
  RewriteRule .* - [G]

  # Gambling / spam keywords in URI
  RewriteCond %{REQUEST_URI} piabet [NC,OR]
  RewriteCond %{REQUEST_URI} casino [NC,OR]
  RewriteCond %{REQUEST_URI} bahis [NC,OR]
  RewriteCond %{REQUEST_URI} porn [NC,OR]
  RewriteCond %{REQUEST_URI} viagra [NC,OR]
  RewriteCond %{REQUEST_URI} cialis [NC]
  RewriteRule .* - [G]

  # 1e. Canonical URL normalization: /index.html → /
  RewriteRule ^index\.html$ / [R=301,L]

  # 1f. Dead URLs / 404 pages — redirect to homepage
  RewriteRule ^services/3d-rendering-dubai/?$ / [R=301,L]
  RewriteRule ^services/walkthrough-animation/?$ / [R=301,L]
  # Legacy/deprecated service pages — redirect to canonical equivalents
  RewriteRule ^services/interactive-configurators/?$ /services/3d-product-configurators [R=301,L]
  RewriteRule ^services/vr-ar-experiences/?$ /services/vr-development [R=301,L]
  RewriteRule ^services/architectural-visualization-uae/?$ /services/architectural-visualization [R=301,L]
  RewriteRule ^services/animation/?$ /services/3d-animation [R=301,L]

  # 1g. Trailing-slash normalization — redirect /contact/ → /contact (prevents duplicate content)
  # Only applies to known SPA routes where the canonical version has no trailing slash
  RewriteRule ^(contact|blog|services|industries|portfolio|about|capabilities|case-studies|projects)/$ /$1 [R=301,L]

  # 1h. Serve prerendered (SSG) static HTML for each public route
  # Build step writes e.g. blog/my-article.html — serves unique title/meta/content per page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 2. SPA Catch-all
  # If requested path is not a real file or directory, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 3. Compression (Brotli + Gzip fallback)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml application/json font/woff2 font/woff application/octet-stream
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent env=!dont-vary
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# 4. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  # Keep machine-readable files fresh so crawlers see new sitemap/blog/llms updates
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|webp|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 5. Security & Frame Permissions
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header set Content-Security-Policy "frame-ancestors 'self' https://carbonpowered.net/ https://drsa-light-it-up.myshopify.com/ https://www.drsa.com/ https://drsa.com/;"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), compute-pressure=()"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
